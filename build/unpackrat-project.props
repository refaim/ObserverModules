<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <RepositoryRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\'))</RepositoryRoot>
    <ArtifactsRoot>$(RepositoryRoot)out\work\manual-msbuild\</ArtifactsRoot>
    <PlatformMoniker Condition="'$(Platform)' == 'Win32'">x86</PlatformMoniker>
    <PlatformMoniker Condition="'$(Platform)' == 'x64'">x64</PlatformMoniker>
    <VcpkgTriplet Condition="'$(Configuration)' != 'ASan' And '$(Configuration)' != 'Fuzz' And '$(Configuration)' != 'UBSan'">unpackrat-$(PlatformMoniker)-windows-static</VcpkgTriplet>
    <VcpkgTriplet Condition="'$(Configuration)' == 'ASan' Or '$(Configuration)' == 'Fuzz'">unpackrat-$(PlatformMoniker)-windows-static-asan</VcpkgTriplet>
    <VcpkgTriplet Condition="'$(Configuration)' == 'UBSan'">unpackrat-$(PlatformMoniker)-windows-static-ubsan</VcpkgTriplet>
    <VcpkgEnableManifest>true</VcpkgEnableManifest>
    <!-- build.ps1 restore owns dependency installation; ordinary builds only consume the restored tree. -->
    <VcpkgManifestInstall>false</VcpkgManifestInstall>
    <!-- Tool installation and updates are always explicit user actions. -->
    <VcpkgAutoBootstrap>false</VcpkgAutoBootstrap>
    <VcpkgManifestRoot>$(RepositoryRoot)</VcpkgManifestRoot>
    <!-- Separate manifest install roots prevent one architecture from pruning another. -->
    <VcpkgInstalledDir Condition="'$(Configuration)' != 'ASan' And '$(Configuration)' != 'Fuzz' And '$(Configuration)' != 'UBSan'">$(ArtifactsRoot)vcpkg_installed\$(PlatformMoniker)\</VcpkgInstalledDir>
    <VcpkgInstalledDir Condition="'$(Configuration)' == 'ASan' Or '$(Configuration)' == 'Fuzz'">$(ArtifactsRoot)vcpkg_installed\$(PlatformMoniker)-asan\</VcpkgInstalledDir>
    <VcpkgInstalledDir Condition="'$(Configuration)' == 'UBSan'">$(ArtifactsRoot)vcpkg_installed\$(PlatformMoniker)-ubsan\</VcpkgInstalledDir>
    <VcpkgApplocalDeps>false</VcpkgApplocalDeps>
    <VcpkgAdditionalInstallOptions>--overlay-triplets=$(RepositoryRoot)build\vcpkg\triplets</VcpkgAdditionalInstallOptions>
    <OutDir>$(ArtifactsRoot)bin\$(PlatformMoniker)\$(Configuration)\</OutDir>
    <IntDir>$(ArtifactsRoot)obj\$(PlatformMoniker)\$(Configuration)\$(ProjectName)\</IntDir>
    <!-- Analysis-only compiles and their tracker logs live in a dedicated intermediate tree so
         the /analyze:only objects and .tlog files cannot poison the ordinary incremental build. -->
    <IntDir Condition="'$(unpackratCompileAnalysis)' == 'true'">$(ArtifactsRoot)obj-analysis\$(PlatformMoniker)\$(Configuration)\$(ProjectName)\</IntDir>
    <TargetDir>$(OutDir)</TargetDir>
    <TargetName>$(ProjectName)</TargetName>
    <GenerateManifest>true</GenerateManifest>
    <LinkIncremental Condition="'$(Configuration)' == 'ASan' Or '$(Configuration)' == 'Fuzz'">false</LinkIncremental>
    <RunCodeAnalysis Condition="'$(unpackratRunCodeAnalysis)' == 'true'">true</RunCodeAnalysis>
    <EnableMicrosoftCodeAnalysis>true</EnableMicrosoftCodeAnalysis>
    <CodeAnalysisRuleSet Condition="'$(unpackratRunCodeAnalysis)' == 'true'">$(RepositoryRoot)build\unpackrat-native-analysis.ruleset</CodeAnalysisRuleSet>
    <unpackratAnalysisReportName Condition="'$(unpackratAnalysisReportName)' == ''">$(ProjectName)</unpackratAnalysisReportName>
    <EnableClangTidyCodeAnalysis Condition="'$(unpackratEnableClangTidy)' == 'true'">true</EnableClangTidyCodeAnalysis>
    <!-- VS passes CL.exe /c to clang-tidy; -Qunused-arguments handles that driver-only flag.
         VS omits ExternalIncludeDirectories from clang-tidy's compile database. Mark only
         restored vcpkg headers as system for LLVM 22 matcher skipping; src stays ordinary. -->
    <ClangTidyAdditionalOptions Condition="'$(unpackratEnableClangTidy)' == 'true'">-Qunused-arguments -imsvc"$(VcpkgInstalledDir)$(VcpkgTriplet)\include" $(ClangTidyAdditionalOptions)</ClangTidyAdditionalOptions>
    <!-- clang-cl resolves compiler-rt relative to its own binary, so an x64 clang-cl targeting
         i686 emits an unsuffixed /DEFAULTLIB:clang_rt.profile.lib that exists in no toolset.
         The caller supplies LLVMRuntimeDir per architecture; the link below names the archive
         explicitly and drops the unresolvable default library. -->
    <unpackratProfileRuntime Condition="'$(Configuration)' == 'Coverage' And '$(Platform)' == 'Win32'">clang_rt.profile-i386.lib</unpackratProfileRuntime>
    <unpackratProfileRuntime Condition="'$(Configuration)' == 'Coverage' And '$(Platform)' == 'x64'">clang_rt.profile-x86_64.lib</unpackratProfileRuntime>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <LanguageStandard Condition="'$(Configuration)' != 'Release' And '$(Configuration)' != 'Coverage' And '$(Configuration)' != 'Fuzz' And '$(Configuration)' != 'UBSan' And '$(unpackratEnableClangTidy)' != 'true'">stdcpp23</LanguageStandard>
      <LanguageStandard Condition="'$(Configuration)' == 'Release' Or '$(Configuration)' == 'Coverage' Or '$(Configuration)' == 'Fuzz' Or '$(Configuration)' == 'UBSan' Or '$(unpackratEnableClangTidy)' == 'true'">stdcpplatest</LanguageStandard>
      <WarningLevel>Level4</WarningLevel>
      <TreatWarningAsError>true</TreatWarningAsError>
      <ConformanceMode>true</ConformanceMode>
      <UseStandardPreprocessor Condition="'$(Configuration)' != 'Coverage' And '$(Configuration)' != 'Fuzz' And '$(Configuration)' != 'UBSan'">true</UseStandardPreprocessor>
      <ExternalWarningLevel>TurnOffAllWarnings</ExternalWarningLevel>
      <TreatAngleIncludeAsExternal>true</TreatAngleIncludeAsExternal>
      <MultiProcessorCompilation Condition="'$(unpackratRunCodeAnalysis)' != 'true'">true</MultiProcessorCompilation>
      <MultiProcessorCompilation Condition="'$(unpackratRunCodeAnalysis)' == 'true'">false</MultiProcessorCompilation>
      <SDLCheck>true</SDLCheck>
      <ControlFlowGuard Condition="'$(Configuration)' == 'Release'">Guard</ControlFlowGuard>
      <DisableAnalyzeExternal Condition="'$(unpackratRunCodeAnalysis)' == 'true'">true</DisableAnalyzeExternal>
      <PREfastLog Condition="'$(unpackratRunCodeAnalysis)' == 'true' And '$(unpackratAnalysisReportDirectory)' != ''">$(unpackratAnalysisReportDirectory)\$(PlatformMoniker)\$(unpackratAnalysisReportName).sarif</PREfastLog>
      <PREfastLog Condition="'$(unpackratRunCodeAnalysis)' == 'true' And '$(unpackratAnalysisReportPath)' != ''">$(unpackratAnalysisReportPath)</PREfastLog>
      <ExceptionHandling>Sync</ExceptionHandling>
      <RuntimeLibrary Condition="'$(Configuration)' == 'Release'">MultiThreaded</RuntimeLibrary>
      <!-- Shared CRT imports keep ASan interceptors valid after instrumented DLL unload. -->
      <RuntimeLibrary Condition="'$(Configuration)' == 'ASan' Or '$(Configuration)' == 'Fuzz'">MultiThreadedDLL</RuntimeLibrary>
      <!-- Match the official LLVM standalone UBSan runtime's DLL CRT. -->
      <RuntimeLibrary Condition="'$(Configuration)' == 'UBSan'">MultiThreadedDLL</RuntimeLibrary>
      <RuntimeLibrary Condition="'$(Configuration)' != 'Release' And '$(Configuration)' != 'ASan' And '$(Configuration)' != 'Fuzz' And '$(Configuration)' != 'UBSan'">MultiThreadedDebug</RuntimeLibrary>
      <DebugInformationFormat>OldStyle</DebugInformationFormat>
      <BasicRuntimeChecks Condition="'$(Configuration)' == 'Debug'">EnableFastChecks</BasicRuntimeChecks>
      <BasicRuntimeChecks Condition="'$(Configuration)' == 'ASan'">Default</BasicRuntimeChecks>
      <SupportJustMyCode Condition="'$(Configuration)' == 'ASan'">false</SupportJustMyCode>
      <Optimization Condition="'$(Configuration)' != 'Release'">Disabled</Optimization>
      <Optimization Condition="'$(Configuration)' == 'Release'">MaxSpeed</Optimization>
      <IntrinsicFunctions Condition="'$(Configuration)' == 'Release'">true</IntrinsicFunctions>
      <FunctionLevelLinking Condition="'$(Configuration)' == 'Release'">true</FunctionLevelLinking>
      <AdditionalIncludeDirectories>$(RepositoryRoot)src;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>NOMINMAX;WINVER=0x0600;_WIN32_WINNT=0x0600;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalOptions>/utf-8 /Zc:__cplusplus %(AdditionalOptions)</AdditionalOptions>
      <AdditionalOptions Condition="'$(Configuration)' == 'Coverage'">/clang:-fprofile-instr-generate /clang:-fcoverage-mapping %(AdditionalOptions)</AdditionalOptions>
      <AdditionalOptions Condition="'$(Configuration)' == 'ASan'">/fsanitize=address %(AdditionalOptions)</AdditionalOptions>
      <!-- One SDK-only alignment exception; rationale and removal rule: docs/ubsan-sdk-wmemcmp.md. -->
      <AdditionalOptions Condition="'$(Configuration)' == 'UBSan'">/clang:-fsanitize=undefined /clang:-fno-sanitize-recover=all /clang:-fsanitize-ignorelist="$(RepositoryRoot)build\ubsan-ignorelist.txt" %(AdditionalOptions)</AdditionalOptions>
      <AdditionalOptions Condition="'$(Configuration)' == 'Fuzz'">/clang:-fsanitize=fuzzer,address %(AdditionalOptions)</AdditionalOptions>
      <!-- Standalone MSVC analysis is driven through the standard ClCompile target's item
           metadata: pure /analyze:only per translation unit with a unique SARIF log beside the
           object file, the existing strict ruleset, and no link-time analysis. Clang-tidy and the
           report-only path stay on their own switches. -->
      <EnablePREfast Condition="'$(unpackratCompileAnalysis)' == 'true'">true</EnablePREfast>
      <!-- Compile-only analysis keeps /Qspectre without selecting unused Spectre libraries. -->
      <SpectreMitigation Condition="'$(Configuration)' == 'Release' Or '$(unpackratCompileAnalysis)' == 'true'">Spectre</SpectreMitigation>
      <!-- The compile-analysis actor sets only unpackratCompileAnalysis, so PREfast must
           take the strict ruleset directly; CodeAnalysisRuleSet is defined only by the
           report-only switch and would otherwise resolve empty here. -->
      <PREfastRulesetFile Condition="'$(unpackratCompileAnalysis)' == 'true'">$(RepositoryRoot)build\unpackrat-native-analysis.ruleset</PREfastRulesetFile>
      <!-- PREfastLog is deliberately not set here: this item definition is evaluated
           before the per-item ObjectFileName overrides exist, so a %(ObjectFileName)
           reference would collapse to the shared $(IntDir) default and same-basename
           translation units would collide on one log. ComputeunpackratCompileAnalysisLogs
           sets it on a target that runs immediately before ClCompile instead. -->
      <AdditionalOptions Condition="'$(unpackratCompileAnalysis)' == 'true'">/analyze:only /analyze:log:format:sarif %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
    <Link>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <GenerateFullProgramDatabaseFile Condition="'$(Configuration)' == 'Release'">true</GenerateFullProgramDatabaseFile>
      <TreatLinkerWarningAsErrors>true</TreatLinkerWarningAsErrors>
      <DataExecutionPrevention>true</DataExecutionPrevention>
      <RandomizedBaseAddress>true</RandomizedBaseAddress>
      <ControlFlowGuard Condition="'$(Configuration)' == 'Release'">Guard</ControlFlowGuard>
      <CETCompat Condition="'$(Configuration)' == 'Release'">true</CETCompat>
      <EnableCOMDATFolding Condition="'$(Configuration)' == 'Release'">true</EnableCOMDATFolding>
      <OptimizeReferences Condition="'$(Configuration)' == 'Release'">true</OptimizeReferences>
      <LinkTimeCodeGeneration Condition="'$(Configuration)' == 'Release'">UseLinkTimeCodeGeneration</LinkTimeCodeGeneration>
      <AdditionalDependencies Condition="'$(Configuration)' == 'UBSan'">$(LLVMRuntimeDir)\clang_rt.ubsan_standalone-x86_64.lib;$(LLVMRuntimeDir)\clang_rt.ubsan_standalone_cxx-x86_64.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <AdditionalDependencies Condition="'$(unpackratProfileRuntime)' != ''">$(LLVMRuntimeDir)\$(unpackratProfileRuntime);%(AdditionalDependencies)</AdditionalDependencies>
      <AdditionalOptions Condition="'$(unpackratProfileRuntime)' != ''">/NODEFAULTLIB:clang_rt.profile.lib %(AdditionalOptions)</AdditionalOptions>
    </Link>
  </ItemDefinitionGroup>

  <Target Name="ValidateunpackratProfileRuntime" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(unpackratCompileAnalysis)' != 'true' And '$(unpackratProfileRuntime)' != '' And '$(LLVMRuntimeDir)' == ''"
           Text="Coverage links the LLVM profile runtime and requires LLVMRuntimeDir; build through build.ps1 test-coverage." />
    <Error Condition="'$(unpackratCompileAnalysis)' != 'true' And '$(Configuration)' == 'Coverage' And '$(unpackratProfileRuntime)' == ''"
           Text="Coverage is supported on Win32 and x64 only." />
  </Target>

  <!-- One nativecodeanalysis.sarif per translation unit, named from each item's resolved
       object file name. Running immediately before ClCompile means every per-item
       ObjectFileName override has been applied, so the log follows the real object file
       (the object directory default or an explicit object file name) and no two units
       share a log. The report-only switch keeps its own single shared report. -->
  <Target Name="ComputeunpackratCompileAnalysisLogs"
          BeforeTargets="ClCompile"
          Condition="'$(unpackratCompileAnalysis)' == 'true'">
    <ItemGroup>
      <ClCompile>
        <!-- The vendor quiet option expects post-link report ingestion. Compile-only analysis
             must emit diagnostics for /WX; remove only that exact option after all imports,
             preserving the other per-item options without conflicting quiet/quiet- flags. -->
        <PREfastAdditionalOptions>$([System.Text.RegularExpressions.Regex]::Replace(`%(PREfastAdditionalOptions)`, `(?&lt;![^;])quiet(?:;|$)`, ``))</PREfastAdditionalOptions>
        <PREfastLog>%(ObjectFileName)%(FileName).nativecodeanalysis.sarif</PREfastLog>
      </ClCompile>
    </ItemGroup>
  </Target>
  <Import Project="$(MSBuildThisFileDirectory)unpackrat-vista.props" />
</Project>
