---
Checks: >
  -*,
  clang-analyzer-*,
  bugprone-*,
  performance-*,
  portability-*,
  -bugprone-easily-swappable-parameters
WarningsAsErrors: '*'
HeaderFilterRegex: '.*[\\/]src[\\/].*'
# Relative vendor includes can contain src/../third_party; keep the existing external exemption.
ExcludeHeaderFilterRegex: '.*[\\/]third_party[\\/].*'
SystemHeaders: false
FormatStyle: file
...
